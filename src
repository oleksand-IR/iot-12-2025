def rabin_karp(haystack: str, needle: str) -> list[int]:
    """
    Повертає список індексів усіх входжень needle у haystack
    за алгоритмом Рабіна-Карпа.
    """
    if not needle:
        return []

    d = 256
    q = 101

    n = len(haystack)
    m = len(needle)

    if m > n:
        return []

    h = pow(d, m - 1, q)

    pattern_hash = 0
    text_hash = 0

    result = []

    for i in range(m):
        pattern_hash = (d * pattern_hash + ord(needle[i])) % q
        text_hash = (d * text_hash + ord(haystack[i])) % q

    for i in range(n - m + 1):
        if pattern_hash == text_hash:
            if haystack[i:i + m] == needle:
                result.append(i)

        if i < n - m:
            text_hash = (
                d * (text_hash - ord(haystack[i]) * h)
                + ord(haystack[i + m])
            ) % q

            if text_hash < 0:
                text_hash += q

    return result
